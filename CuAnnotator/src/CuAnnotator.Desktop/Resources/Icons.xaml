<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 16×16 vector icons for the annotation toolbox (stroked with the button foreground). -->
    <Geometry x:Key="Icon.Select">M3,1 L3,14 L6.5,10.5 L9,15.5 L11,14.5 L8.5,9.5 L13,9.5 Z</Geometry>
    <Geometry x:Key="Icon.Rectangle">M2,3 H14 V13 H2 Z</Geometry>
    <Geometry x:Key="Icon.Polygon">M2,12 L5,3 L11,2 L14,8 L9,14 Z M1,11 h2 v2 h-2 Z M4,2 h2 v2 h-2 Z M10,1 h2 v2 h-2 Z M13,7 h2 v2 h-2 Z M8,13 h2 v2 h-2 Z</Geometry>
    <Geometry x:Key="Icon.Lasso">M8,2 C13,2 15,5 13,8 C11,11 4,11 3,8 C2,5 4,2 8,2 M5,10 C4,13 6,15 8,14</Geometry>
    <Geometry x:Key="Icon.SmartContour">M3,9 C3,5 6,3 9,4 C12,5 13,8 11,11 C9,14 5,14 4,12 Z M13,1 V5 M11,3 H15</Geometry>
    <Geometry x:Key="Icon.ForegroundBrush">M8,2 A6,6 0 1 1 7.99,2 Z M8,5 V11 M5,8 H11</Geometry>
    <Geometry x:Key="Icon.BackgroundBrush">M8,2 A6,6 0 1 1 7.99,2 Z M5,8 H11</Geometry>
    <Geometry x:Key="Icon.BoundaryBrush">M1,12 C4,4 6,14 9,6 C11,1 13,6 15,4 M2,15 L14,15</Geometry>
    <Geometry x:Key="Icon.Eraser">M3,10 L9,4 L14,9 L9,14 H6 Z M6,7 L11,12 M6,14 H15</Geometry>
    <Geometry x:Key="Icon.VertexEditor">M3,3 L13,5 L11,13 L4,11 Z M2,2 h2 v2 h-2 Z M12,4 h2 v2 h-2 Z M10,12 h2 v2 h-2 Z M3,10 h2 v2 h-2 Z</Geometry>
    <Geometry x:Key="Icon.Split">M2,4 H14 V12 H2 Z M10,1 L6,15</Geometry>
    <Geometry x:Key="Icon.Merge">M6,4 A4,4 0 1 1 5.99,4 Z M10,4 A4,4 0 1 1 9.99,4 Z</Geometry>
    <Geometry x:Key="Icon.Fill">M3,7 L8,2 L13,7 L8,12 Z M3,7 H13 M14,10 C13,12 15,13 15.5,11 C15.5,10 14.5,9 14.5,9</Geometry>
    <Geometry x:Key="Icon.ColorSelect">M11,1 L15,5 L12,8 L8,4 Z M9.5,5.5 L2,13 V14.5 H3.5 L11,7</Geometry>
    <Geometry x:Key="Icon.MagicWand">M2,14 L10,6 M12,1 V4 M10.5,2.5 H13.5 M14,6 V9 M12.5,7.5 H15.5</Geometry>
    <Geometry x:Key="Icon.Measure">M1,11 L11,1 L15,5 L5,15 Z M4,8 L6,10 M6,6 L8,8 M8,4 L10,6</Geometry>

    <Style x:Key="ToolIcon" TargetType="Path">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="StrokeThickness" Value="1.3" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
</ResourceDictionary>
