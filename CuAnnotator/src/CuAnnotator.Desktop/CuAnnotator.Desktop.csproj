<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>CuAnnotator</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)'==''">win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\CuAnnotator.Domain\CuAnnotator.Domain.csproj" />
    <ProjectReference Include="..\..\src\CuAnnotator.Vision\CuAnnotator.Vision.csproj" />
    <ProjectReference Include="..\..\src\CuAnnotator.Application\CuAnnotator.Application.csproj" />
    <ProjectReference Include="..\..\src\CuAnnotator.Infrastructure\CuAnnotator.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\CuAnnotator.Contracts\CuAnnotator.Contracts.csproj" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="$(OpenCvSharpVersion)" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>
</Project>
