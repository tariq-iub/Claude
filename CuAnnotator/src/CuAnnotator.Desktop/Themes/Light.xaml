<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light theme: every brush key must exist in both Light.xaml and Dark.xaml. -->
    <SolidColorBrush x:Key="WindowBackground" Color="#F3F5F9" />
    <SolidColorBrush x:Key="PanelBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PanelAltBackground" Color="#F7F9FC" />
    <SolidColorBrush x:Key="PanelBorder" Color="#DCE2EC" />
    <SolidColorBrush x:Key="ToolbarBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ViewportBackground" Color="#2B2F36" />
    <SolidColorBrush x:Key="TextPrimary" Color="#1B2333" />
    <SolidColorBrush x:Key="TextSecondary" Color="#5B6578" />
    <SolidColorBrush x:Key="Accent" Color="#2F6FD0" />
    <SolidColorBrush x:Key="AccentStrong" Color="#1D3A6B" />
    <SolidColorBrush x:Key="AccentSoft" Color="#E3ECFA" />
    <SolidColorBrush x:Key="HoverBackground" Color="#EEF3FB" />
    <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#2E8B57" />
    <SolidColorBrush x:Key="WarningBrush" Color="#C98A00" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#C0392B" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
</ResourceDictionary>
