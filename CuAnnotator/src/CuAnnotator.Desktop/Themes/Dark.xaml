<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark theme: every brush key must exist in both Light.xaml and Dark.xaml. -->
    <SolidColorBrush x:Key="WindowBackground" Color="#16191F" />
    <SolidColorBrush x:Key="PanelBackground" Color="#1E222A" />
    <SolidColorBrush x:Key="PanelAltBackground" Color="#232832" />
    <SolidColorBrush x:Key="PanelBorder" Color="#323947" />
    <SolidColorBrush x:Key="ToolbarBackground" Color="#1E222A" />
    <SolidColorBrush x:Key="ViewportBackground" Color="#0E1014" />
    <SolidColorBrush x:Key="TextPrimary" Color="#E6E9EF" />
    <SolidColorBrush x:Key="TextSecondary" Color="#9AA3B5" />
    <SolidColorBrush x:Key="Accent" Color="#5B9BFF" />
    <SolidColorBrush x:Key="AccentStrong" Color="#9CC1FF" />
    <SolidColorBrush x:Key="AccentSoft" Color="#24344F" />
    <SolidColorBrush x:Key="HoverBackground" Color="#2A303B" />
    <SolidColorBrush x:Key="InputBackground" Color="#262B35" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#2E8B57" />
    <SolidColorBrush x:Key="WarningBrush" Color="#C98A00" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#C0392B" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
</ResourceDictionary>
