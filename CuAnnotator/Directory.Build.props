<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <Company>CuAnnotator</Company>
    <Product>CuAnnotator — Copper Corrosion Annotation Studio</Product>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <OpenCvSharpVersion>4.13.0.20260627</OpenCvSharpVersion>
  </PropertyGroup>
</Project>
