{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-qbe/schemas/mcq_schema.json",
  "title": "MCQGenerationOutput",
  "description": "Strict schema an MCQ-generation LLM call must produce. Matches docs/PHASE0-DESIGN.md section 12 / master prompt section 12.",
  "type": "object",
  "required": ["question", "options", "correct_option", "explanation", "topic", "difficulty", "bloom_level", "confidence"],
  "additionalProperties": false,
  "properties": {
    "question": {"type": "string", "minLength": 8},
    "options": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {"type": "string", "minLength": 1}
    },
    "correct_option": {
      "type": "integer",
      "minimum": 0,
      "description": "0-based index into options[] of the single correct answer."
    },
    "explanation": {"type": "string", "minLength": 8},
    "topic": {"type": "string"},
    "subtopic": {"type": "string"},
    "difficulty": {"type": "string", "enum": ["easy", "medium", "hard"]},
    "bloom_level": {"type": "string", "enum": ["remember", "understand", "apply", "analyze"]},
    "sources": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Chunk/source identifiers the question is grounded in; empty only if the caller explicitly allowed ungrounded generation."
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
